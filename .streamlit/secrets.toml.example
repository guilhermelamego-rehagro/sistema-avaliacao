# Copie para secrets.toml e preencha com seus valores reais.
# NUNCA commite secrets.toml no GitHub.
#
# Importante (TOML): chaves de nível raiz devem ficar ANTES de qualquer [seção].
# Se ambiente ficar depois de [gcp_service_account] ou dentro de [planilhas],
# o app não encontra e usa a planilha de teste.

ambiente = "teste"

[gcp_service_account]
type = "service_account"
project_id = "seu-projeto-gcp"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "sua-service-account@projeto.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/..."
universe_domain = "googleapis.com"

[planilhas]
id_teste = "ID_PLANILHA_TESTE"
id_producao = "ID_PLANILHA_PRODUCAO"
id_frequencia = "ID_PLANILHA_FREQUENCIA"

[supabase]
url = "https://SEU_PROJETO.supabase.co"
anon_key = "eyJ..."
service_role_key = "eyJ..."

senha_temporaria_padrao = "rehagro2026"

# E-mails com acesso de coordenador (alternativa à coluna coordenador no Supabase)
[coordenacao]
emails = ["seu.email@rehagro.com.br"]
